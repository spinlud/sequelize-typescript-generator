{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Run the CLI from source (tsx) against a sqlite DB, emitting native models.
            // Point -S at your own sqlite file (create .scratch/local.sqlite first).
            "type": "node",
            "request": "launch",
            "name": "CLI: sqlite → native",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/src/bin/cli.ts",
            "args": [
                "-D", "sqlite",
                "-S", "${workspaceFolder}/.scratch/local.sqlite",
                "-o", "${workspaceFolder}/output-models",
                "-F", "native",
                "--clean"
            ],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Same as above but emitting sequelize-typescript decorator models.
            "type": "node",
            "request": "launch",
            "name": "CLI: sqlite → decorators",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/src/bin/cli.ts",
            "args": [
                "-D", "sqlite",
                "-S", "${workspaceFolder}/.scratch/local.sqlite",
                "-o", "${workspaceFolder}/output-models",
                "-F", "decorators",
                "--clean"
            ],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Print CLI usage.
            "type": "node",
            "request": "launch",
            "name": "CLI: --help",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/src/bin/cli.ts",
            "args": ["--help"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Run the CLI against a sqlite DB whose path and output format you choose at launch.
            "type": "node",
            "request": "launch",
            "name": "CLI: sqlite (prompt path + format)",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/src/bin/cli.ts",
            "args": [
                "-D", "sqlite",
                "-S", "${input:sqliteStorage}",
                "-o", "${workspaceFolder}/output-models",
                "-F", "${input:format}",
                "--clean"
            ],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Run all unit tests under the Node debugger.
            "type": "node",
            "request": "launch",
            "name": "Jest: unit (all)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/unit", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Run all sqlite integration tests under the Node debugger.
            "type": "node",
            "request": "launch",
            "name": "Jest: sqlite integration (all)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/sqlite", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Run the currently open test file under the Node debugger.
            "type": "node",
            "request": "launch",
            "name": "Jest: current file",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["${relativeFile}", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Regenerate sqlite golden fixtures for the golden tests.
            "type": "node",
            "request": "launch",
            "name": "Jest: sqlite golden update",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/sqlite", "-t", "golden", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "GOLDEN_UPDATE": "1"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Debug the postgres integration tests. preLaunchTask brings the DB up and waits;
            // the container is left running afterwards — run the "db: down (all)" task to stop it.
            "type": "node",
            "request": "launch",
            "name": "Integration: postgres (debug)",
            "preLaunchTask": "db: postgres (up + wait)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/postgres", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "TEST_DB_DIALECT": "postgres",
                "TEST_DB_HOST": "localhost",
                "TEST_DB_PORT": "1234"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Debug the mysql integration tests. preLaunchTask brings the DB up and waits;
            // the container is left running afterwards — run the "db: down (all)" task to stop it.
            "type": "node",
            "request": "launch",
            "name": "Integration: mysql (debug)",
            "preLaunchTask": "db: mysql (up + wait)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/mysql", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "TEST_DB_DIALECT": "mysql",
                "TEST_DB_HOST": "localhost",
                "TEST_DB_PORT": "1234"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Debug the mariadb integration tests. preLaunchTask brings the DB up and waits;
            // the container is left running afterwards — run the "db: down (all)" task to stop it.
            "type": "node",
            "request": "launch",
            "name": "Integration: mariadb (debug)",
            "preLaunchTask": "db: mariadb (up + wait)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/mariadb", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "TEST_DB_DIALECT": "mariadb",
                "TEST_DB_HOST": "localhost",
                "TEST_DB_PORT": "1234"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Debug the mssql integration tests. preLaunchTask brings the DB up and waits;
            // the container is left running afterwards — run the "db: down (all)" task to stop it.
            // Requires Node <= 23 locally (tedious/SlowBuffer broken on Node >= 24).
            "type": "node",
            "request": "launch",
            "name": "Integration: mssql (debug)",
            "preLaunchTask": "db: mssql (up + wait)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": ["src/tests/integration/mssql", "--runInBand"],
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "TEST_DB_DIALECT": "mssql",
                "TEST_DB_HOST": "localhost",
                "TEST_DB_PORT": "1234"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "inputs": [
        {
            "id": "sqliteStorage",
            "type": "promptString",
            "description": "Path to the sqlite database file",
            "default": "${workspaceFolder}/.scratch/local.sqlite"
        },
        {
            "id": "format",
            "type": "pickString",
            "description": "Output format",
            "options": ["native", "decorators"],
            "default": "native"
        }
    ]
}
